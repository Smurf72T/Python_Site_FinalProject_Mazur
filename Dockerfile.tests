# Tests Dockerfile
FROM python:3.12-slim

WORKDIR /app

# Установка зависимостей системы
RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Копирование requirements
COPY requirements.txt .

# Копирование кода
COPY . .

# Установка Python зависимостей
RUN pip install --no-cache-dir \
    --retries 5 \
    --timeout 30 \
    -r requirements.txt
RUN pip install --no-cache-dir \
    --retries 5 \
    --timeout 30 \
    pytest pytest-django pytest-cov black flake8 isort

# Создание директорий
RUN mkdir -p /app/media /app/staticfiles /app/logs /app/test_results

# Переменные окружения
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings
ENV PYTEST_ADDOPTS="--cov=apps --cov-report=html:/app/test_results/htmlcov --cov-report=term-missing --html=/app/test_results/report.html --self-contained-html"

# Скрипт запуска тестов
COPY docker/run_tests.sh /run_tests.sh
RUN apt-get update && apt-get install -y dos2unix \
    && dos2unix /run_tests.sh \
    && chmod +x /run_tests.sh \
    && rm -rf /var/lib/apt/lists/*

# Запуск тестов
CMD ["/run_tests.sh"]
